# --- Zorunlu ---
MOODLE_URL=https://moodle.bogazici.edu.tr
# Moodle > Preferences > Security keys > "Moodle mobile web service" satırındaki key (Reset'ledikten sonraki YENİ değer)
MOODLE_TOKEN=
# Boş bırak = ÜCRETSİZ MOD (Claude kullanılmaz, kimse para çekmez).
# İleride belgelerin içini de okutmak istersen console.anthropic.com'dan key alıp buraya yaz.
ANTHROPIC_API_KEY=
# Telegram'da @BotFather > /newbot ile aldığın token
TELEGRAM_BOT_TOKEN=
# Boş bırak: "setup-telegram" komutu otomatik doldurur
TELEGRAM_CHAT_ID=

# --- İsteğe bağlı ---
# Sadece bu dersleri tara (ID'ler için: python moodle_brief.py courses)
COURSE_IDS=
# Bu dersleri atla
EXCLUDE_COURSE_IDS=
# Belge okuma (ucuz) ve brifing yazma modeli
EXTRACT_MODEL=claude-haiku-5-5
BRIEF_MODEL=claude-sonnet-5-5
# Brifingin gönderileceği saat (install.sh ile ayarlanır)
SEND_TIME=07:30
MAX_FILE_MB=25
LOOKAHEAD_DAYS=45
